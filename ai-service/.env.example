# Local me Ollama (free). Production me ye badal ke anthropic ya openai kar dena.
AI_PROVIDER=ollama

# Ollama (aapke PC par). Docker container host ko is naam se dhundhta hai.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Production keys (local me khali rehne do):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Postgres (vector store ai-service manage karti hai)
DATABASE_URL=postgresql://postgres:PASSWORD@postgres:5432/automation
