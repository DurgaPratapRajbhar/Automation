    {
      "name": "6. WhatsApp Webhook",
      "item": [
        {
          "name": "Verify (Meta GET challenge)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/webhooks/whatsapp?hub.mode=subscribe&hub.verify_token={{meta_verify_token}}&hub.challenge=12345",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "whatsapp"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{meta_verify_token}}"
                },
                {
                  "key": "hub.challenge",
                  "value": "12345"
                }
              ]
            }
          }
        },
        {
          "name": "Receive — UNSIGNED (expect 403)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"object\":\"whatsapp_business_account\",\"entry\":[{\"changes\":[{\"value\":{\"metadata\":{\"phone_number_id\":\"1211076188745310\"},\"contacts\":[{\"profile\":{\"name\":\"Fake User\"}}],\"messages\":[{\"from\":\"919999999999\",\"id\":\"wamid.FAKE123\",\"text\":{\"body\":\"hello fake\"}}]}}]}]}"
            },
            "url": {
              "raw": "{{base_url}}/api/webhooks/whatsapp",
              "host": [
