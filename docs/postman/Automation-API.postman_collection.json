                "type": "text/javascript",
                "exec": [
                  "// Secret environment se aata hai — collection me kabhi mat likhna",
                  "const secret = pm.environment.get(\"meta_app_secret\");",
                  "if (!secret) { throw new Error(\"Environment me meta_app_secret set karo\"); }",
                  "const sig = CryptoJS.HmacSHA256(pm.request.body.raw, secret).toString();",
                  "// Variable me save; Headers tab {{hub_signature}} se bhejta hai (upsert har Postman version me kaam nahi karta)",
                  "pm.environment.set(\"hub_signature\", \"sha256=\" + sig);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
